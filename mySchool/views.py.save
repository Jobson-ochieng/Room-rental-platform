from django.shortcuts import render,redirect,get_object_or_404
from django.contrib.auth.forms import UserCreationForm
def list(request):
  form=Learners.objects.filter(users=request.user)
  return render(request,"html/students.html",{'forms':form})
def create(request):
 if request.method=="POST":
  form=LearnersForm(request.POST)
  if form.is_valid():
   students= form.save(commit=False)
   students.user=request.user
   students.save()
   return redirect('stud')
 else:
  form=LearnersForm()
 return render(request,'html/list.html',{'form':form})
def reg(request):
 if request.method=='POST':
  form=UserCreationForm(request.POST)
  if form.is_valid:
   form.save()
   return redirect('login')
 else:
  form=UserCreationForm()
 return render(request,'reg/reg.html')
